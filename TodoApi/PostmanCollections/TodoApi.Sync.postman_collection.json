    {
      "name": "Sync Flow - Manual E2E",
      "description": "Run these requests in order. For outbound steps, wait a few seconds or inspect Hangfire. For inbound steps, trigger `todoapi-inbound-sync` manually from the Hangfire dashboard or wait for the 1 minute recurring job.",
      "item": [
        {
          "name": "00 - Reset ExternalApi",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{externalApiBaseUrl}}/__test/reset"
          }
        },
        {
          "name": "01 - Outbound Create Local TodoList",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Local TodoList created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('todoListId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Local groceries\"\n}"
            },
            "url": "{{todoApiBaseUrl}}/api/todolists"
          }
        },
        {
          "name": "02 - Verify TodoList Arrived In ExternalApi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const lists = pm.response.json();",
                  "const created = lists.find(x => x.name === 'Local groceries');",
                  "pm.test('ExternalApi contains Local groceries', function () {",
                  "  pm.expect(created).to.not.be.undefined;",
                  "});",
                  "if (created) {",
                  "  pm.collectionVariables.set('externalListId', created.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{externalApiBaseUrl}}/todolists"
          }
        },
        {
          "name": "03 - Verify Local TodoList Has ExternalId",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Local TodoList has ExternalId', function () {",
                  "  pm.expect(body.external_id || body.externalId).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{todoApiBaseUrl}}/api/todolists/:todoListId"
          }
        },
        {
          "name": "04 - Outbound Create Local Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Local Item created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('itemId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Milk\",\n  \"isCompleted\": false\n}"
            },
            "url": "{{todoApiBaseUrl}}/api/todolists/:todoListId/items"
          }
        },
        {
          "name": "05 - Verify Item Arrived In ExternalApi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const lists = pm.response.json();",
                  "const list = lists.find(x => x.name === 'Local groceries');",
                  "const item = list && list.items ? list.items.find(x => x.description === 'Milk') : null;",
                  "pm.test('ExternalApi contains Milk item', function () {",
                  "  pm.expect(item).to.not.be.undefined;",
                  "});",
                  "if (item) {",
                  "  pm.collectionVariables.set('externalItemId', item.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{externalApiBaseUrl}}/todolists"
          }
        },
        {
          "name": "06 - Outbound Update Local TodoList",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Local groceries updated\"\n}"
            },
            "url": "{{todoApiBaseUrl}}/api/todolists/:todoListId"
          }
        },
        {
          "name": "07 - Verify TodoList Update In ExternalApi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const lists = pm.response.json();",
                  "pm.test('ExternalApi contains updated local list', function () {",
                  "  pm.expect(lists.some(x => x.name === 'Local groceries updated')).to.equal(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{externalApiBaseUrl}}/todolists"
          }
        },
        {
          "name": "08 - Outbound Update Local Item",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Milk updated\",\n  \"isCompleted\": true\n}"
            },
            "url": "{{todoApiBaseUrl}}/api/todolists/:todoListId/items/:itemId"
          }
        },
        {
          "name": "09 - Verify Item Update In ExternalApi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const lists = pm.response.json();",
                  "const list = lists.find(x => x.name === 'Local groceries updated');",
                  "const item = list && list.items ? list.items.find(x => x.description === 'Milk updated') : null;",
                  "pm.test('ExternalApi contains updated item', function () {",
                  "  pm.expect(item).to.not.be.undefined;",
                  "  pm.expect(item.completed).to.equal(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{externalApiBaseUrl}}/todolists"
          }
        },
        {
          "name": "10 - Inbound Create External TodoList",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('External TodoList created for inbound sync', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('externalListId', body.id);",
                  "if (body.items && body.items.length > 0) {",
                  "  pm.collectionVariables.set('externalItemId', body.items[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"source_id\": null,\n  \"name\": \"External work\",\n  \"items\": [\n    {\n      \"source_id\": null,\n      \"description\": \"External task\",\n      \"completed\": false\n    }\n  ]\n}"
            },
            "url": "{{externalApiBaseUrl}}/todolists"
          }
        },
        {
          "name": "11 - Verify External TodoList Imported Locally",
          "description": "Before running this request, trigger `todoapi-inbound-sync` in Hangfire or wait up to 1 minute.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const lists = pm.response.json();",
                  "pm.test('TodoApi contains inbound imported list', function () {",
                  "  pm.expect(lists.some(x => x.name === 'External work')).to.equal(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{todoApiBaseUrl}}/api/todolists"
          }
        },
        {
          "name": "12 - Inbound Update External TodoList",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"External work updated\"\n}"
            },
            "url": "{{externalApiBaseUrl}}/todolists/:externalListId"
          }
        },
        {
          "name": "13 - Verify External Update Imported Locally",
          "description": "Before running this request, trigger `todoapi-inbound-sync` in Hangfire or wait up to 1 minute.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const lists = pm.response.json();",
                  "pm.test('TodoApi contains updated inbound list', function () {",
                  "  pm.expect(lists.some(x => x.name === 'External work updated')).to.equal(true);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{todoApiBaseUrl}}/api/todolists"
          }
        },
        {
          "name": "14 - Outbound Delete Local Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{todoApiBaseUrl}}/api/todolists/:todoListId/items/:itemId"
          }
        },
        {
          "name": "15 - Verify Deleted Item Missing In ExternalApi",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const lists = pm.response.json();",
                  "const list = lists.find(x => x.name === 'Local groceries updated');",
                  "const item = list && list.items ? list.items.find(x => x.description === 'Milk updated') : null;",
                  "pm.test('ExternalApi no longer contains deleted item', function () {",
                  "  pm.expect(item).to.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{externalApiBaseUrl}}/todolists"
          }
        },
        {
          "name": "16 - Inbound Delete External TodoList",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{externalApiBaseUrl}}/todolists/:externalListId"
          }
        },
        {
          "name": "17 - Verify External Delete Reflected Locally",
          "description": "Before running this request, trigger `todoapi-inbound-sync` in Hangfire or wait up to 1 minute.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const lists = pm.response.json();",
                  "pm.test('TodoApi no longer returns soft-deleted inbound list', function () {",
                  "  pm.expect(lists.some(x => x.name === 'External work updated')).to.equal(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{todoApiBaseUrl}}/api/todolists"
          }
        }
      ]
    }
  ]
